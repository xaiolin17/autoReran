# ==========================================
# 股票数据分析平台 - 环境配置示例
# ==========================================
# 复制此文件为 .env 并根据需要修改配置

# ==========================================
# 数据库配置 - 默认使用 SQLite（无需额外安装）
# ==========================================
# SQLite 连接字符串（本地开发推荐）
DATABASE_URL=sqlite:///./stock_data.db
# PostgreSQL 连接字符串（生产环境或 Docker 环境使用）
# DATABASE_URL=postgresql://stock_user:stock_password@localhost:5432/stock_db

# PostgreSQL 配置（仅用于 docker-compose）
# POSTGRES_USER=stock_user
# POSTGRES_PASSWORD=stock_password
# POSTGRES_DB=stock_db

# ==========================================
# JWT 认证配置
# ==========================================
SECRET_KEY=your-secret-key-change-in-production-please-generate-a-random-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Celery 配置 - 本地环境可以禁用
# ==========================================
# Redis 配置（仅用于 Celery，本地环境可选）
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================
# 应用配置
# ==========================================
API_V1_STR=/api/v1
PROJECT_NAME=股票数据分析平台
DEBUG=True

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log

# ==========================================
# 缓存配置
# ==========================================
CACHE_ENABLED=True
CACHE_MAXSIZE=1024
CACHE_DEFAULT_TTL=300
CACHE_STOCK_DATA_TTL=300
CACHE_INDICATOR_TTL=600

# ==========================================
# 爬虫配置
# ==========================================
SCHEDULER_ENABLED=True
CRAWL_INTERVAL_MINUTES=5
SINA_STOCK_URL=https://hq.sinajs.cn/list=
EASTMONEY_URL=https://push2.eastmoney.com/api/qt/stock/kline/get

# ==========================================
# TickFlow 数据源配置（必填）
# ==========================================
# TickFlow API Key - 从 https://tickflow.org 获取
# 注意：此密钥不应提交到代码仓库，仅在本地环境变量中设置
TICKFLOW_API_KEY=your-tickflow-api-key-here

# ==========================================
# 模型配置
# ==========================================
MODELS_DIR=models

# ==========================================
# 安全配置
# ==========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

CSP_ENABLED=False
CSRF_ENABLED=False
