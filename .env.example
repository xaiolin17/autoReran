# 数据库配置
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://stock_user:stock_password@localhost:5432/stock_db
# SQLite 连接字符串（开发环境可选）
# DATABASE_URL=sqlite:///./stock_data.db

# PostgreSQL 配置（用于 docker-compose）
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_DB=stock_db

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production-please-generate-a-random-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 应用配置
API_V1_STR=/api/v1
PROJECT_NAME=股票数据分析平台
DEBUG=True

# 日志配置
LOG_LEVEL=INFO
# LOG_FILE=./logs/app.log

# 缓存配置
CACHE_ENABLED=True
CACHE_MAXSIZE=1024
CACHE_DEFAULT_TTL=300
CACHE_STOCK_DATA_TTL=300
CACHE_INDICATOR_TTL=600

# 爬虫配置
SCHEDULER_ENABLED=True
CRAWL_INTERVAL_MINUTES=5
SINA_STOCK_URL=https://hq.sinajs.cn/list=
EASTMONEY_URL=https://push2.eastmoney.com/api/qt/stock/kline/get

# 模型配置
MODELS_DIR=models
